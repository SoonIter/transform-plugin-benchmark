{
  "name": "transform-plugin-benchmark",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": "24.18.1"
  },
  "scripts": {
    "artifacts": "node --import tsx scripts/generate-artifacts.ts",
    "bench:scaling": "node --import tsx scripts/bench-styled-components-scaling.ts",
    "bench:styled-components": "node --import tsx scripts/bench-styled-components.ts",
    "charts": "node --import tsx scripts/generate-charts.ts",
    "reproduce:styled-components": "node --import tsx scripts/reproduce-styled-components.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "type-check": "tsgo --noEmit",
    "bench:walkers": "BENCH_RUNS=6 BENCH_TIME=10000 BENCH_WARMUP=3000 PROFILE_TIME=5000 PROFILE_WARMUP=1000 BENCH_REPRODUCTION_COMMAND=\"npm run bench:walkers\" node --import tsx scripts/bench-styled-components.ts --walkers"
  },
  "dependencies": {
    "@babel/core": "8.0.7",
    "@swc-next/core": "0.4.0",
    "@swc-next/walker": "0.4.0",
    "@swc/core": "1.16.13",
    "@swc/plugin-styled-components": "17.0.0",
    "babel-plugin-styled-components": "2.3.0",
    "oxc-codegen": "0.153.0",
    "oxc-parser": "0.153.0",
    "picomatch": "4.0.7",
    "styled-components": "6.5.3",
    "tinybench": "6.2.1",
    "yuku-ast": "0.18.0",
    "yuku-codegen": "0.18.0",
    "yuku-parser": "0.18.0",
    "zimmerframe": "1.1.5"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "overrides": {
    "babel-plugin-styled-components": {
      "@babel/core": "$@babel/core"
    }
  }
}
